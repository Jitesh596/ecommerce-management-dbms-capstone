# ===================================================
# Fashionista Backend Environment Variables Template
# Copy this file to .env and fill in your real credentials
# ===================================================

# Server Port
PORT=5000
NODE_ENV=production

# MySQL Database Connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=ecommerce_management_db

# Security
JWT_SECRET=fashionista_super_secure_jwt_secret_key_change_in_prod

# CORS Allowed Origin (Frontend URL in production)
FRONTEND_URL=https://your-fashionista-frontend.vercel.app
