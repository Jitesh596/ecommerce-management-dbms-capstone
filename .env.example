# ===================================================
# Fashionista Frontend Environment Variables Template
# ===================================================

# For Local Development:
# Leave empty or commented out. Vite's proxy automatically routes /api to http://localhost:5000
# VITE_API_URL=

# For Production (e.g., Vercel Deployment):
# Set this in your Vercel Project Settings > Environment Variables:
# VITE_API_URL=https://your-fashionista-backend.up.railway.app
